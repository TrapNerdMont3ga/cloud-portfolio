---
import BaseLayout from '../layouts/BaseLayout.astro'
import Mascot from '../components/Mascot.astro'
import ProjectCard from '../components/ProjectCard.astro'
---

<BaseLayout>
<!-- Home / Hero Section - Upgraded TrapNerd Style -->
<section id="home" class="hero-section relative min-h-screen flex items-center overflow-hidden">
  
  <!-- Background Layer -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#0a1628] via-[#0f1f3d] to-[#0a0f1f]"></div>
  
  <!-- Subtle Grid Pattern -->
  <div class="absolute inset-0 card-grid-pattern" style="background-size: 50px 50px; opacity: 0.6;"></div>
  
  <!-- Glow Orbs -->
  <div class="card-glow-orb orb-blue" style="top: 10%; left: 10%; width: 300px; height: 300px;"></div>
  <div class="card-glow-orb orb-purple" style="bottom: 15%; right: 15%; width: 250px; height: 250px;"></div>

  <div class="container relative z-10">
    <div class="hero-grid grid md:grid-cols-2 gap-12 items-center">

      <!-- Left: Text Content -->
      <div class="hero-copy max-w-2xl">
        <h1 class="text-5xl md:text-6xl font-bold leading-none tracking-tighter text-white mb-6">
          Cloud, AI, and Security<br />
          Systems<br />
          <span class="text-sky-400">Built for Real-World Businesses</span>
        </h1>

        <p class="text-xl text-zinc-400 mb-10 max-w-lg">
          From cloud architecture to AI automation and security systems,<br />
          TrapNerd delivers reliable, scalable solutions that actually work.
        </p>

        <div class="hero-actions flex flex-col sm:flex-row gap-4">
          <a href="#contact" 
             class="cta-btn px-8 py-4 text-lg font-semibold rounded-2xl bg-sky-500 hover:bg-sky-400 text-black transition-all duration-300 flex items-center justify-center gap-3 group">
            Get a Free Infrastructure Review
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>

          <a href="#portfolio" 
             class="hero-secondary px-8 py-4 text-lg font-medium text-sky-400 hover:text-sky-300 flex items-center gap-2 transition-colors">
            See how we solve real problems →
          </a>
        </div>
      </div>

      <!-- Right: Mascot -->
      <div class="hero-mascot flex justify-center md:justify-end">
        <div class="relative">
          <img
            src="/images/trapnerd-mascot.png"
            alt="TrapNerd Mascot"
            class="w-full max-w-[380px] drop-shadow-2xl transition-transform duration-500 hover:scale-105"
            loading="eager"
          />
          <!-- Subtle glow behind mascot -->
          <div class="absolute inset-0 bg-sky-500/10 blur-3xl rounded-full -z-10 scale-110"></div>
        </div>
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <!-- <div class="absolute bottom-10 left-1/2 -translate-x-1/2 text-zinc-500 flex flex-col items-center gap-2 text-sm">
    <span>Scroll to explore</span>
    <div class="w-px h-12 bg-gradient-to-b from-transparent via-zinc-500 to-transparent"></div>
  </div> -->
</section>

  <!-- Portfolio Section -->
<section id="portfolio" class="section portfolio-section">
  <div class="container">
    <h2>Portfolio</h2>
    <p>Check out some of our projects and client work.</p>

    <div class="portfolio-grid">
<!-- Project Card: OptiPrim3 -->
<ProjectCard
  title="OptiPrim3 – AI Logistics Platform"
  description="Scalable logistics with dispatch automation and container tracking."
  videoSrc="/videos/hero.mov"
  poster="/images/optiprim3-thumb.jpg"
  href="https://optiprim3.com"
  tags={["AWS", "AI", "Logistics"]}
  badge="Live"
  bg="bg-1"  
/>

      <!-- Project Card 2 -->
<ProjectCard
  title="Static Site on AWS S3"
  description="Zero-server hosting with global CDN distribution, custom domains, and automated CI/CD deployment."
  videoSrc="/videos/s3-site.mov"
  poster="/images/s3-thumb.jpg"
  href="https://your-s3-project-link.com"
  tags={["S3", "CloudFront", "DNS"]}
  badge="Case Study" 
  bg="bg-2" 
/>
      <!-- Project Card 3 -->
<ProjectCard
  title="Cloud Security with AWS IAM"
  description="Role-based access control architecture with least-privilege policies and automated compliance auditing."
  videoSrc="/videos/iam-security.mov"
  poster="/images/iam-thumb.jpg"
  href="https://your-iam-project-link.com"
  tags={["IAM", "Security", "Audit"]}
  badge="Zero-Trust"
  bg="bg-3" 
/>

</section>

<!-- Contact Section -->
<section id="contact" class="section contact-section">
  <div class="container">
    <h2>Contact Us</h2>
    <p>Get in touch for a free consultation or quote.</p>

<form id="contact-form">
  <input type="text" name="name" placeholder="Name" required />
  <input type="email" name="email" placeholder="Email" required />
  <textarea name="message" placeholder="Message" required></textarea>
  <button type="submit">Send Message</button>
</form>

<script type="module">
  const form = document.getElementById('contact-form');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await res.json();

      if (res.ok) {
        alert('Message sent successfully!');
        form.reset();
      } else {
        alert(result.error || 'Failed to send message.');
      }
    } catch (err) {
      console.error(err);
      alert('Error sending message.');
    }
  });
</script>
</section>
</BaseLayout>
