---
import BaseLayout from '../layouts/BaseLayout.astro'
import ProjectCard from '../components/ProjectCard.astro'
---

<BaseLayout>

<!-- Home / Hero Section -->
<section id="home" class="hero-section relative min-h-screen flex items-center overflow-hidden">
  
  <!-- Background Layer -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#0a1628] via-[#0f1f3d] to-[#0a0f1f]"></div>
  
  <!-- Subtle Grid Pattern -->
  <div class="absolute inset-0 card-grid-pattern" style="background-size: 50px 50px; opacity: 0.6;"></div>
  
  <!-- Glow Orbs -->
  <div class="card-glow-orb orb-blue" style="top: 10%; left: 10%; width: 300px; height: 300px;"></div>
  <div class="card-glow-orb orb-purple" style="bottom: 15%; right: 15%; width: 250px; height: 250px;"></div>

  <div class="container relative z-10">
    <div class="hero-grid grid md:grid-cols-2 gap-12 items-center">

      <!-- Left: Text Content -->
      <div class="hero-copy max-w-2xl">
        <h1 class="text-5xl md:text-6xl font-bold leading-none tracking-tighter text-white mb-6">
          Cloud, AI, and Security<br />
          Systems<br />
          <span class="text-sky-400">Built for Real-World Businesses</span>
        </h1>

        <p class="text-xl text-zinc-400 mb-10 max-w-lg">
          From cloud architecture to AI automation and security systems,<br />
          TrapNerd delivers reliable, scalable solutions that actually work.
        </p>

        <div class="hero-actions flex flex-col sm:flex-row gap-4">
          <a href="#contact" 
             class="cta-btn px-8 py-4 text-lg font-semibold rounded-2xl bg-sky-500 hover:bg-sky-400 text-black transition-all duration-300 flex items-center justify-center gap-3 group">
            Get a Free Infrastructure Review
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>

          <a href="#portfolio" 
             class="hero-secondary px-8 py-4 text-lg font-medium text-sky-400 hover:text-sky-300 flex items-center gap-2 transition-colors">
            See how we solve real problems →
          </a>
        </div>
      </div>

      <!-- Right: Mascot -->
      <div class="hero-mascot flex justify-center md:justify-end">
        <div class="relative">
          <img
            src="/images/trapnerd-mascot.png"
            alt="TrapNerd Mascot"
            class="w-full max-w-[380px] drop-shadow-2xl transition-transform duration-500 hover:scale-105"
            loading="eager"
          />
          <div class="absolute inset-0 bg-sky-500/10 blur-3xl rounded-full -z-10 scale-110"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Services Section - Rotating Spotlight (Upgraded) -->
<section id="services" class="section relative py-24 overflow-hidden bg-[#0a1628]">
  
  <!-- Background Effects -->
  <div class="absolute inset-0 card-grid-pattern" style="background-size: 50px 50px; opacity: 0.6;"></div>
  <div class="card-glow-orb orb-blue" style="top: 10%; left: 10%; width: 420px; height: 420px; opacity: 0.18;"></div>
  <div class="card-glow-orb orb-purple" style="bottom: 20%; right: 15%; width: 360px; height: 360px; opacity: 0.14;"></div>

  <div class="container relative z-10">
    <div class="text-center mb-16">
      <h2 class="text-5xl md:text-6xl font-bold tracking-tighter mb-4">What I Deliver</h2>
      <p class="text-xl text-zinc-400 max-w-xl mx-auto">
        Four core services. Real results for small businesses and startups.
      </p>
    </div>

    <!-- Main Rotator Card -->
    <div id="service-rotator" class="max-w-3xl mx-auto bg-gradient-to-br from-zinc-900 to-zinc-950 border border-zinc-700 rounded-3xl p-12 md:p-16 text-center transition-all duration-700 hover:border-sky-500/50">
      
      <div id="service-icon" class="text-7xl mb-8 transition-all duration-500">🌐</div>
      
      <h3 id="service-title" class="text-4xl md:text-5xl font-semibold mb-6 text-white">Web Development</h3>
      
      <p id="service-description" class="text-lg md:text-xl text-zinc-400 leading-relaxed min-h-[140px]">
        Modern, fast-loading websites that look professional and actually bring in customers.
      </p>

      <!-- Navigation -->
      <div class="flex justify-center gap-4 mt-12">
        <button onclick="prevService()" 
                class="px-8 py-4 border border-zinc-700 hover:border-sky-500 rounded-2xl text-sm font-medium transition-all hover:bg-zinc-900">
          ← Previous
        </button>
        <button onclick="nextService()" 
                class="px-8 py-4 border border-zinc-700 hover:border-sky-500 rounded-2xl text-sm font-medium transition-all hover:bg-zinc-900">
          Next →
        </button>
      </div>
    </div>

    <!-- Service Pills -->
    <div class="flex flex-wrap justify-center gap-3 mt-12">
      <button onclick="showService(0)" class="service-pill active">Web Development</button>
      <button onclick="showService(1)" class="service-pill">AI Automation</button>
      <button onclick="showService(2)" class="service-pill">Cloud Architecture</button>
      <button onclick="showService(3)" class="service-pill">Cybersecurity</button>
    </div>
  </div>
</section>

<!-- Portfolio Section -->
<section id="portfolio" class="section portfolio-section">
  <div class="container">
    <h2>Portfolio</h2>
    <p>Check out some of our projects and client work.</p>

    <div class="portfolio-grid">
      <!-- Project Card: OptiPrim3 -->
       <!-- TrapNerd.cloud - Featured Cloud Project -->
<ProjectCard
  title="TrapNerd.cloud – Modern AWS Portfolio"
  description="Fully static site hosted on Amazon S3 with CloudFront CDN for global edge delivery, Route 53 for custom domain + HTTPS, and automated deployments via GitHub Actions. Built with Astro, Tailwind CSS, and a custom dark-tech design system."
  videoSrc="/videos/hero.mov"
  poster="/images/trapnerd-thumb.jpg"
  href="https://trapnerd.cloud"
  tags={["S3", "CloudFront", "Route 53", "GitHub Actions", "Astro"]}
  badge="Live"
  bg="bg-4" 
/>
      <ProjectCard
        title="OptiPrim3 – AI Logistics Platform"
        description="Scalable logistics with dispatch automation and container tracking."
        videoSrc="/videos/hero.mov"
        poster="/images/optiprim3-thumb.jpg"
        href="https://optiprim3.com"
        tags={["AWS", "AI", "Logistics"]}
        badge="Live"
        bg="bg-1"  
      />

      <!-- Project Card 2 -->
      <ProjectCard
        title="Static Site on AWS S3"
        description="Zero-server hosting with global CDN distribution, custom domains, and automated CI/CD deployment."
        videoSrc="/videos/s3-site.mov"
        poster="/images/s3-thumb.jpg"
        href="https://your-s3-project-link.com"
        tags={["S3", "CloudFront", "DNS"]}
        badge="Case Study" 
        bg="bg-2" 
      />

      <!-- Project Card 3 -->
      <ProjectCard
        title="Cloud Security with AWS IAM"
        description="Role-based access control architecture with least-privilege policies and automated compliance auditing."
        videoSrc="/videos/iam-security.mov"
        poster="/images/iam-thumb.jpg"
        href="https://your-iam-project-link.com"
        tags={["IAM", "Security", "Audit"]}
        badge="Zero-Trust"
        bg="bg-3" 
      />
    </div>
  </div>
</section>

<!-- Contact Section - Premium Style -->
<section id="contact" class="contact-section relative py-24 overflow-hidden">
  
  <!-- Background Effects -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#0a1628] via-[#0f1f3d] to-[#0a0f1f]"></div>
  <div class="absolute inset-0 card-grid-pattern" style="background-size: 60px 60px; opacity: 0.45;"></div>
  
  <div class="card-glow-orb orb-blue" style="top: 15%; left: 8%; width: 320px; height: 320px; opacity: 0.18;"></div>
  <div class="card-glow-orb orb-purple" style="bottom: 20%; right: 12%; width: 280px; height: 280px; opacity: 0.15;"></div>

  <div class="container relative z-10">
    <div class="max-w-2xl mx-auto text-center mb-16">
      <h2 class="text-5xl md:text-6xl font-bold tracking-tighter text-white mb-6">Contact Us</h2>
      <p class="text-xl text-zinc-400">
        Get in touch for a free consultation or quote.<br />
        We'll get back to you within 24 hours.
      </p>
    </div>

    <div class="max-w-xl mx-auto">
<form class="contact-form" action="https://formspree.io/f/xrerwggn" method="POST">
  
  <h2>Contact</h2>
  <p class="form-subtext">Have a project, question, or opportunity? Let’s connect.</p>

  <input type="text" name="name" placeholder="Name" required>
  <input type="email" name="email" placeholder="Email" required>
  <input type="hidden" name="_redirect" value="https://trapnerd.cloud/thank-you.html">
  <textarea name="message" rows="5" placeholder="Message" required></textarea>

  <button type="submit">Send Message</button>

  <p class="form-note">Response time: within 24–48 hours</p>

</form>
      <p class="text-center text-zinc-500 text-sm mt-10">
        Prefer email? Reach us at <a href="mailto:admin@trapnerd.cloud" class="text-sky-400 hover:text-sky-300 underline">admin@trapnerd.cloud</a>
      </p>
    </div>
  </div>
</section>

<script>
  // Active Navigation Highlight on Scroll
  const navLinks = document.querySelectorAll('.nav-link');
  const sections = ['home', 'services', 'portfolio', 'contact'];

  function updateActiveNav() {
    let current = '';
    
    sections.forEach(sectionId => {
      const section = document.getElementById(sectionId);
      if (!section) return;
      
      const sectionTop = section.offsetTop;
      if (scrollY >= sectionTop - 200) {
        current = sectionId;
      }
    });

    navLinks.forEach(link => {
      link.classList.remove('active');
      if (link.getAttribute('href') === `#${current}`) {
        link.classList.add('active');
      }
    });
  }

  window.addEventListener('scroll', updateActiveNav);
  updateActiveNav(); // Run once on load
</script>

<script>
  const services = [
    { 
      icon: "🌐", 
      title: "Web Development", 
      desc: "Modern, fast-loading websites that look professional and actually bring in customers." 
    },
    { 
      icon: "🤖", 
      title: "AI Automation", 
      desc: "Smart AI workflows that eliminate repetitive tasks and save you 10–20 hours every week." 
    },
    { 
      icon: "☁️", 
      title: "Cloud Architecture", 
      desc: "Scalable, secure, and cost-efficient AWS infrastructure that grows with your business." 
    },
    { 
      icon: "🔒", 
      title: "Cybersecurity", 
      desc: "Zero Trust security setups so you can sleep peacefully knowing your business is protected." 
    }
  ];

  let current = 0;

  function showService(index: any) {
    current = index % services.length;

    const iconEl = document.getElementById('service-icon');
    const titleEl = document.getElementById('service-title');
    const descEl = document.getElementById('service-description');

    if (iconEl) iconEl.textContent = services[current].icon;
    if (titleEl) titleEl.textContent = services[current].title;
    if (descEl) descEl.textContent = services[current].desc;

    // Update active pill
    document.querySelectorAll('.service-pill').forEach((pill, i) => {
      pill.classList.toggle('active', i === current);
    });
  }

  function nextService() {
    current = (current + 1) % services.length;
    showService(current);
  }

  function prevService() {
    current = (current - 1 + services.length) % services.length;
    showService(current);
  }

  // Auto-rotate every 4 seconds
  setInterval(nextService, 4000);

  // Initialize when page loads
  document.addEventListener('DOMContentLoaded', () => {
    showService(0);
  });
</script>

</BaseLayout>