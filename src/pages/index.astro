---
import BaseLayout from '../layouts/BaseLayout.astro'
import Mascot from '../components/Mascot.astro'
import ProjectCard from '../components/ProjectCard.astro'
---

<BaseLayout>
  <!-- Home Section -->
<section id="home" class="section home-section">
  <div class="container hero-grid">

    <div class="hero-copy">
  <h1>
    Cloud, AI, and Security Systems<br />
    Built for Real-World Businesses
  </h1>

  <p class="hero-subtext">
    From cloud architecture to AI automation and security systems,
    TrapNerd delivers reliable, scalable solutions that actually work.
  </p>

  <div class="hero-actions">
    <a href="#contact" class="cta-btn">
      Get a Free Infrastructure Review
    </a>

    <a href="#portfolio" class="hero-secondary">
      See how we solve real problems →
    </a>
  </div>
</div>

    <div class="hero-mascot">
  <img
    src="/images/trapnerd-mascot.png"
    alt="TrapNerd Mascot"
    loading="eager"
  />
</div>

  </div>
</section>

  <!-- Services Section -->
  <section id="services" class="section services-section">
    <div class="container">
      <h2>Our Services</h2>
<ul class="no-bullets">
  <li>☁️ Cloud Architecture & AWS Solutions</li>
  <li>🔐 Cybersecurity & Zero-Trust Setup</li>
  <li>🤖 AI Automation & Intelligent Workflows</li>
  <li>🛠️ Ongoing Support & Consulting</li>
</ul>
      <p>We tailor solutions to fit your unique business needs and goals.</p>
    </div>
  </section>

  <!-- Portfolio Section -->
<section id="portfolio" class="section portfolio-section">
  <div class="container">
    <h2>Portfolio</h2>
    <p>Check out some of our projects and client work.</p>

    <div class="portfolio-grid">
<!-- Project Card: OptiPrim3 -->
<ProjectCard
  title="OptiPrim3 – AI Logistics Platform"
  description="Scalable logistics with dispatch automation and container tracking."
  videoSrc="/videos/hero.mov"
  poster="/images/optiprim3-thumb.jpg"
  href="https://optiprim3.com"
  tags={["AWS", "AI", "Logistics"]}
  badge="Live"
  bg="bg-1"  
/>

      <!-- Project Card 2 -->
<ProjectCard
  title="Static Site on AWS S3"
  description="Zero-server hosting with global CDN distribution, custom domains, and automated CI/CD deployment."
  videoSrc="/videos/s3-site.mov"
  poster="/images/s3-thumb.jpg"
  href="https://your-s3-project-link.com"
  tags={["S3", "CloudFront", "DNS"]}
  badge="Case Study"
  bg="bg-2" 
/>
      <!-- Project Card 3 -->
<ProjectCard
  title="Cloud Security with AWS IAM"
  description="Role-based access control architecture with least-privilege policies and automated compliance auditing."
  videoSrc="/videos/iam-security.mov"
  poster="/images/iam-thumb.jpg"
  href="https://your-iam-project-link.com"
  tags={["IAM", "Security", "Audit"]}
  badge="Zero-Trust"
  bg="bg-3" 
/>

</section>

<!-- Contact Section -->
<section id="contact" class="section contact-section">
  <div class="container">
    <h2>Contact Us</h2>
    <p>Get in touch for a free consultation or quote.</p>

<form id="contact-form">
  <input type="text" name="name" placeholder="Name" required />
  <input type="email" name="email" placeholder="Email" required />
  <textarea name="message" placeholder="Message" required></textarea>
  <button type="submit">Send Message</button>
</form>

<script type="module">
  const form = document.getElementById('contact-form');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await res.json();

      if (res.ok) {
        alert('Message sent successfully!');
        form.reset();
      } else {
        alert(result.error || 'Failed to send message.');
      }
    } catch (err) {
      console.error(err);
      alert('Error sending message.');
    }
  });
</script>
</section>
</BaseLayout>
